# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection string (e.g. Prisma Postgres, Neon, Supabase or a local PostgreSQL)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# JWT — use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Image storage (Cloudinary). Optional: if left empty, admins can still add images by URL,
# but the "Upload image" button is disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=travelsense

# Seed: initial administrator account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@travelsense.test
SEED_ADMIN_PASSWORD=Admin@12345
